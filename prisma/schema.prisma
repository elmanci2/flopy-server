// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DeploymentStatus {
  SUCCESS
  FAILURE
}

model DeploymentKey {
  id        String   @id @default(cuid())
  key       String   @unique @default(cuid())
  channel   String
  createdAt DateTime @default(now())

  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId String

  @@unique([appId, channel])
}

model App {
  id        String   @id @default(cuid())
  name      String   @unique
  apiKey    String   @unique @default(cuid())
  createdAt DateTime @default(now())

  releases Release[]

  users          UsersOnApps[]
  deploymentKeys DeploymentKey[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  apps UsersOnApps[]
}

model UsersOnApps {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId  String

  @@id([userId, appId])
}

model Deployment {
  id             String           @id @default(cuid())
  clientUniqueId String
  status         DeploymentStatus
  createdAt      DateTime         @default(now())

  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
}

model ReleaseDiff {
  id        String   @id @default(cuid())
  patchUrl  String
  hash      String
  createdAt DateTime @default(now())

  fromReleaseId String
  fromRelease   Release @relation("DiffsFromRelease", fields: [fromReleaseId], references: [id], onDelete: Cascade)

  toReleaseId String
  toRelease   Release  @relation("DiffsToRelease", fields: [toReleaseId], references: [id], onDelete: Cascade)
  Release     Release? @relation(fields: [releaseId], references: [id])
  releaseId   String?

  @@unique([fromReleaseId, toReleaseId])
}

model Release {
  id                  String   @id @default(cuid())
  appId               String
  channel             String
  targetBinaryVersion String
  bundleUrl           String
  hash                String   @unique
  isMandatory         Boolean  @default(false)
  rolloutPercentage   Int      @default(100)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  deployments          Deployment[]
  ReleaseDiff          ReleaseDiff[]
  diffsFromThisRelease ReleaseDiff[] @relation("DiffsFromRelease")
  diffsToThisRelease   ReleaseDiff[] @relation("DiffsToRelease")

  @@index([appId, channel, isActive, createdAt])
}
