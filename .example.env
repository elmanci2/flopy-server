# .env

# --- Configuración de la Base de Datos ---
DATABASE_URL="file:./prisma/dev.db"

# =================================================
# --- CONFIGURACIÓN DE ALMACENAMIENTO TIPO S3 (Ejemplo para Cloudflare R2) ---
# =================================================

# El nombre de tu bucket en R2
S3_BUCKET_NAME="flopy-ota-updates"

# Para R2, la región es siempre "auto"
S3_REGION="auto"

# El endpoint de la API S3 de R2. Reemplaza <ACCOUNT_ID> con tu ID de cuenta de Cloudflare.
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

# La URL pública de tu bucket. Puede ser la misma que el endpoint o un dominio personalizado.
# Asegúrate de que termine con una barra '/'
S3_PUBLIC_URL_PREFIX="https://<ACCOUNT_ID>.r2.cloudflarestorage.com/flopy-ota-updates/"

# Tus credenciales de API R2 (las creas en el dashboard de Cloudflare R2)
S3_ACCESS_KEY_ID="TU_ACCESS_KEY_ID_DE_R2"
S3_SECRET_ACCESS_KEY="TU_SECRET_ACCESS_KEY_DE_R2"

JWT_SECRET="una_cadena_muy_larga_y_secreta_que_nadie_pueda_adivinar"
